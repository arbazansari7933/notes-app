<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Search Results</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            padding: 40px;
            background: #f5f5f5;
        }
        .container {
            width: 100%;
            max-width: 600px;
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            text-align: center;
        }
        h1 {
            margin-bottom: 5px;
        }
        .subtitle {
            color: gray;
            margin-bottom: 25px;
            font-size: 14px;
        }
        .back-link {
            text-decoration: none;
            color: #0066cc;
            display: inline-block;
            margin-bottom: 20px;
        }
        .note {
            border: 1px solid #ddd;
            padding: 12px;
            margin-bottom: 12px;
            border-radius: 8px;
            text-align: left;
        }
        .note-title {
            font-size: 18px;
            font-weight: bold;
            margin: 0 0 6px 0;
        }
        .note-desc {
            margin-bottom: 10px;
            color: #555;
            font-size: 14px;
        }
        .note-actions a {
            margin-right: 10px;
            text-decoration: none;
            font-size: 14px;
        }
        .btn-view { color: #0066cc; }
        .btn-edit { color: #28a745; }
        .btn-delete { color: red; }

        .footer-msg {
            margin-top: 30px;
            font-size: 14px;
            background: #007bff;
            color: white;
            padding: 12px;
            border-radius: 8px;
            font-weight: 600;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>Search Results</h1>
        <p class="subtitle">Made by <b>Arbaz Ansari</b></p>

        <a href="/" class="back-link">← Back to Notes</a>

        <h3>Searching for: "<%= query %>"</h3>
        <br>

        <% if (results.length === 0) { %>
            <p style="color:#777;">No notes found.</p>
        <% } %>

        <% results.forEach(note => { %>
            <div class="note">
                <p class="note-title"><%= note.title %></p>
                <p class="note-desc"><%= note.content.substring(0, 80) %>...</p>

                <div class="note-actions">
                    <a class="btn-view" href="/note/<%= note._id %>">View</a>
                    <a class="btn-edit" href="/edit/<%= note._id %>">Edit</a>
                    <a class="btn-delete" href="/delete/<%= note._id %>" onclick="return confirm('Delete this note?')">Delete</a>
                </div>
            </div>
        <% }) %>

        <p class="footer-msg">
            🚀 More features & improved UI coming in the next update!
        </p>

    </div>

</body>
</html>
