<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Search Results</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 20px;
        }
        .note {
            border: 1px solid #ccc;
            padding: 12px;
            margin-bottom: 10px;
            border-radius: 5px;
        }
        h1 {
            margin-bottom: 10px;
        }
        a {
            text-decoration: none;
            color: #0088ff;
        }
        .back {
            display: inline-block;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>

    <!-- Back -->
    <a href="/" class="back">← Back to Notes</a>

    <h1>Search results for: "<%= query %>"</h1>

    <% if (results.length === 0) { %>
        <p>No notes found.</p>
    <% } %>

    <% results.forEach(note => { %>
        <div class="note">
            <h3><%= note.title %></h3>
            <p><%= note.content.substring(0, 60) %>...</p>
            <a href="/note/<%= note._id %>">View</a> |
            <a href="/edit/<%= note._id %>">Edit</a> |
            <a 
                href="/delete/<%= note._id %>" 
                onclick="return confirm('Delete this note?')"
                style="color:red;"
            >
                Delete
            </a>
        </div>
    <% }) %>

</body>
</html>
