<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Add Note</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            padding: 40px;
            background: #f5f5f5;
        }
        .container {
            width: 100%;
            max-width: 600px;
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            text-align: center;
        }
        h1 {
            margin-bottom: 5px;
        }
        .subtitle {
            color: gray;
            margin-bottom: 25px;
            font-size: 14px;
        }
        form {
            margin-top: 10px;
            text-align: left;
        }
        input, textarea {
            width: 100%;
            padding: 12px;
            border-radius: 6px;
            border: 1px solid #ccc;
            margin-bottom: 15px;
            font-size: 14px;
        }
        .btn {
            padding: 10px 18px;
            background: #0088ff;
            color: white;
            text-decoration: none;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            font-size: 14px;
        }
        .back-link {
            text-decoration: none;
            color: #0066cc;
            display: inline-block;
            margin-bottom: 20px;
        }

        .footer-msg {
            margin-top: 30px;
            font-size: 14px;
            background: #007bff;
            color: white;
            padding: 12px;
            border-radius: 8px;
            font-weight: 600;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>Add New Note</h1>
        <p class="subtitle">Made by <b>Arbaz Ansari</b></p>

        <a href="/" class="back-link">← Back to Notes</a>

        <form action="/add" method="POST">

            <label>Title:</label>
            <input type="text" name="title" required>

            <label>Content:</label>
            <textarea name="content" rows="5" required></textarea>

            <button type="submit" class="btn">Save Note</button>
        </form>

        <p class="footer-msg">
            🚀 More features & improved UI coming in the next update!
        </p>

    </div>

</body>
</html>
