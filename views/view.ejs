<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= note.title %></title>

    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 20px;
        }
        .note-box {
            border: 1px solid #ccc;
            padding: 15px;
            border-radius: 5px;
            width: 500px;
        }
        h1 {
            margin-top: 0;
        }
        .actions a {
            margin-right: 12px;
            text-decoration: none;
            color: #0088ff;
        }
        .delete {
            color: red;
        }
    </style>
</head>
<body>

    <!-- Back link -->
    <a href="/">← Back to Notes</a>

    <div class="note-box">
        <h1><%= note.title %></h1>
        <p><%= note.content %></p>

        <p><small>Created: <%= new Date(note.createdAt).toLocaleString() %></small></p>

        <div class="actions">
            <a href="/edit/<%= note._id %>">Edit</a>
            <a 
                href="/delete/<%= note._id %>" 
                class="delete"
                onclick="return confirm('Are you sure you want to delete this note?')"
                style="color:red;"
            >
                Delete
            </a>
        </div>
    </div>

</body>
</html>
