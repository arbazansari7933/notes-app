<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>
        <%= note.title %>
    </title>

    <style>
        body {
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            padding: 40px;
            background: #f5f5f5;
        }

        .container {
            width: 100%;
            max-width: 600px;
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            text-align: center;
        }

        h1 {
            margin-bottom: 10px;
        }

        .subtitle {
            color: gray;
            font-size: 14px;
            margin-bottom: 25px;
        }

        .note-box {
            text-align: left;
            border: 1px solid #ddd;
            padding: 15px;
            border-radius: 8px;
            background: #fff;
        }

        .action-btn {
            padding: 6px 14px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            color: white;
            font-size: 14px;
            text-decoration: none;
            display: inline-flex;
            justify-content: center;
            align-items: center;
            margin-right: 8px;
        }

        /* Specific colors */


        .edit-btn {
            background: #28a745;
        }

        .delete-btn {
            background: #dc3545;
        }

        .back-link {
            text-decoration: none;
            color: #0066cc;
            display: inline-block;
            margin-bottom: 20px;
        }

        .footer-msg {
            margin-top: 30px;
            font-size: 14px;
            background: #007bff;
            color: white;
            padding: 12px;
            border-radius: 8px;
            font-weight: 600;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>
            <%= note.title %>
        </h1>
        <p class="subtitle">Made by <b>Arbaz Ansari</b></p>

        <a href="/" class="back-link">← Back to Notes</a>

        <div class="note-box">
            <p>
                <%= note.content %>
            </p>

            <p><small>Created: <%= new Date(note.createdAt).toLocaleString() %></small></p>

            <div class="actions">
                <a class="action-btn edit-btn" href="/edit/<%= note._id %>">Edit</a>
                <a class="action-btn delete-btn" href="/delete/<%= note._id %>"
                    onclick="return confirm('Delete this note?')">
                    Delete
                </a>
            </div>
        </div>

        <p class="footer-msg">
            🚀 More features & improved UI coming in the next update!
        </p>

    </div>

</body>

</html>