<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= note.title %></title>

    <style>
        body {
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            padding: 40px;
            background: #f5f5f5;
        }
        .container {
            width: 100%;
            max-width: 600px;
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            text-align: center;
        }
        h1 {
            margin-bottom: 10px;
        }
        .subtitle {
            color: gray;
            font-size: 14px;
            margin-bottom: 25px;
        }
        .note-box {
            text-align: left;
            border: 1px solid #ddd;
            padding: 15px;
            border-radius: 8px;
            background: #fff;
        }
        .actions a {
            margin-right: 12px;
            text-decoration: none;
            font-size: 14px;
        }
        .btn-edit { color: #28a745; }
        .btn-delete { color: red; }

        .back-link {
            text-decoration: none;
            color: #0066cc;
            display: inline-block;
            margin-bottom: 20px;
        }

        .footer-msg {
            margin-top: 30px;
            font-size: 14px;
            background: #007bff;
            color: white;
            padding: 12px;
            border-radius: 8px;
            font-weight: 600;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1><%= note.title %></h1>
        <p class="subtitle">Made by <b>Arbaz Ansari</b></p>

        <a href="/" class="back-link">← Back to Notes</a>

        <div class="note-box">
            <p><%= note.content %></p>

            <p><small>Created: <%= new Date(note.createdAt).toLocaleString() %></small></p>

            <div class="actions">
                <a href="/edit/<%= note._id %>" class="btn-edit">Edit</a>
                <a 
                    href="/delete/<%= note._id %>"
                    class="btn-delete"
                    onclick="return confirm('Are you sure you want to delete this note?')"
                >
                    Delete
                </a>
            </div>
        </div>

        <p class="footer-msg">
            🚀 More features & improved UI coming in the next update!
        </p>

    </div>

</body>
</html>
