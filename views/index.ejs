<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Notes App</title>

    <!-- Clean Center UI -->
    <style>
        body {
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            padding: 40px;
            background: #f5f5f5;
        }

        .container {
            width: 100%;
            max-width: 600px;
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            text-align: center;
        }

        h1 {
            margin-bottom: 5px;
        }

        .subtitle {
            color: gray;
            margin-bottom: 25px;
            font-size: 14px;
        }

        .note {
            border: 1px solid #ddd;
            padding: 12px;
            margin-bottom: 12px;
            border-radius: 8px;
            text-align: left;
        }

        .note-title {
            font-size: 18px;
            font-weight: bold;
            margin: 0;
        }

        .add-btn {
            padding: 10px 18px;
            background: #0088ff;
            color: white;
            text-decoration: none;
            border-radius: 6px;
            display: inline-block;
            margin-bottom: 25px;
        }

        input {
            padding: 8px;
            width: 70%;
        }

        button {
            padding: 8px 15px;
        }

        .action-btn {
            padding: 6px 14px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            color: white;
            font-size: 14px;
            text-decoration: none;
            display: inline-flex;
            justify-content: center;
            align-items: center;
            margin-right: 8px;
        }

        /* Specific colors */
        .view-btn {
            background: #007bff;
        }

        .edit-btn {
            background: #28a745;
        }

        .delete-btn {
            background: #dc3545;
        }

        /* Strong Blue Banner Footer */
        .footer-msg {
            margin-top: 30px;
            font-size: 14px;
            background: #007bff;
            color: white;
            padding: 12px;
            border-radius: 8px;
            font-weight: 600;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>Notes App</h1>
        <p class="subtitle">Made by <b>Arbaz Ansari</b></p>

        <!-- Add Note Button -->
        <a class="add-btn" href="/add">+ Add New Note</a>

        <!-- Search -->
        <form action="/search" method="POST">
            <input type="text" name="search" required>
            <button type="submit">Search</button>
        </form>

        <hr style="margin: 25px 0;">

        <!-- Notes List -->
        <% if (notes.length===0) { %>
            <p>No notes yet. Create one!</p>
            <% } %>

                <% notes.forEach(note=> { %>
                    <div class="note">
                        <p class="note-title">
                            <%= note.title %>
                        </p>
                        <p>
                            <%= note.content.substring(0, 60) %>...
                        </p>

                        <div class="note-actions">
                            <a class="action-btn view-btn" href="/note/<%= note._id %>">View</a>
                            <a class="action-btn edit-btn" href="/edit/<%= note._id %>">Edit</a>
                            <a class="action-btn delete-btn" href="/delete/<%= note._id %>"
                                onclick="return confirm('Delete this note?')">
                                Delete
                            </a>
                        </div>

                    </div>
                    <% }) %>

                        <!-- FOOTER -->
                        <p class="footer-msg">
                            🚀 More features & improved UI coming in the next update!
                        </p>

    </div>

</body>

</html>